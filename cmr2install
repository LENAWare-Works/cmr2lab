#!/usr/bin/env python3
"""
cmr2install — the GUI installer. One page, in a browser, no terminal needed.

    python3 cmr2install                 serve on 127.0.0.1:8092 and open the browser
    python3 cmr2install --port 8099
    python3 cmr2install --no-open       serve, do not open a browser
    python3 cmr2install --check         run the detection once, print it, exit
    python3 cmr2install --scan-json     same, machine readable

It finds Colin McRae Rally 2.0's install in three tiers, exactly like the
question asks:

    TIER 1  the known/default locations for every way it gets installed
            (Steam library, Steam Proton prefix, GOG/Wine prefix, disc, dev copy)
    TIER 2  an automatic search of the whole plausible tree if tier 1 misses
    TIER 3  point it at the folder yourself — a real browser, on the real
            filesystem, because a web page cannot see absolute paths on its own

Then it writes the launcher and shows you the exact line it wrote.

Needs cmr2lab next to it (it borrows the detection and the .desktop writer —
one place where the truth about what an install looks like lives).

No dependencies. Python 3 stdlib only.
"""
import sys, os, json, argparse, webbrowser, importlib.util
import importlib.machinery
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

HERE = os.path.dirname(os.path.abspath(__file__))

def _load_lab():
    """cmr2lab has no .py extension, so it cannot be imported by name."""
    for p in (os.path.join(HERE, "cmr2lab"),
              os.path.join(HERE, "cmr2lab.py"),
              os.path.join(os.path.dirname(HERE), "cmr2lab")):
        if os.path.isfile(p):
            ld = importlib.machinery.SourceFileLoader("cmr2lab", p)
            spec = importlib.util.spec_from_loader("cmr2lab", ld)
            m = importlib.util.module_from_spec(spec)
            ld.exec_module(m)
            return m
    return None

SCAN_PATH = os.environ.get("CMR2_DIR") or None      # tier 1/2 can be pinned, same as --path
lab = _load_lab()
if lab is None:                                              # pragma: no cover
    sys.stderr.write(
        "cmr2install needs cmr2lab in the same folder.\n"
        f"  looked in: {HERE}\n")
    sys.exit(2)

