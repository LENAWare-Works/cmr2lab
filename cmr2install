# ------------------------------------------------------------------- helpers --
def _locate(**kw):
    """cmr2lab.locate() changed shape: v0.2.0 returned (info, log), v0.2.2 returns
    (info, log, hard_fail, found). Accept BOTH -- this file and cmr2lab are shipped
    as a pair and have been out of step once already (the page 500'd)."""
    try:
        r = lab.locate(**kw)
    except TypeError:                       # v0.2.0 locate() has no 'everything'
        kw.pop("everything", None)
        r = lab.locate(**kw)
    if isinstance(r, (tuple, list)):
        if len(r) >= 4:
            info, log, fail, found = r[0], r[1], r[2], r[3]
        elif len(r) == 2:
            info, log = r
            fail, found = None, ([('found', '', info)] if info else [])
        else:                                              # unknown shape: best effort
            info, log, fail, found = (r[0] if r else None), [], None, []
    else:
        info, log, fail, found = r, [], None, []
    return info, list(log or []), fail, list(found or [])

def scan():
    """tier 1 + tier 2, through cmr2lab's own detect.

    Lists EVERY install the search turns up, not just the first -- on a real Deck
    there can be two (a dev copy and a GOG copy inside a Proton prefix) and which
    one you want is yours to pick, not the tool's."""
    _info, log, fail, found_infos = _locate(extra_path=SCAN_PATH, everything=True)
    found = []
    for label, path, info in found_infos:
        if not isinstance(info, dict):
            continue
        c, t = lab.counts(info["data"])
        found.append({
            "root": info["root"],
            "data": info["data"],
            "native": info["native"],
            "retail": info["retail"],
            "cars": c, "tracks": t,
            "how": label or next((l[1] for l in log if l[0] == "found"), "search"),
        })
    places = [{"state": s, "label": l, "path": p, "note": (n if isinstance(n, str) else "")}
              for (s, l, p, n) in log]
    return {"found": found, "places": places, "hard_fail": fail}

def exes_in(d):
    nat, ret = lab._exe_in(d)
    return {"native": nat, "retail": ret}

def looks_like_game(d):
    """what a folder has to look like to be worth clicking"""
    out = {"game_root": False, "content": False, "exe": []}
    if not os.path.isdir(d):
        return out
    try:
        names = os.listdir(d)
    except OSError:
        return out
    low = {n.lower(): n for n in names}
    if "cars" in low and "tracks" in low:
        out["content"] = True
    g = [names[i] for i, n in enumerate(names) if n.lower() == "game"]
    if g:
        sub = os.path.join(d, g[0])
        try:
            sl = {n.lower() for n in os.listdir(sub)}
        except OSError:
            sl = set()
        if "cars" in sl and "tracks" in sl:
            out["content"] = True
            out["game_root"] = True
    for n in ("cmr2.exe", "cm2.exe", "cmr2", "cm2", "cmr2-native"):
        if n in low:
            out["exe"].append(os.path.join(d, low[n]))
    return out

def browse(path):
    path = os.path.abspath(os.path.expanduser(path or os.path.expanduser("~")))
    if not os.path.isdir(path):
        path = os.path.expanduser("~")
    try:
        names = sorted(os.listdir(path), key=lambda s: s.lower())
    except PermissionError:
        return {"path": path, "parent": os.path.dirname(path),
                "entries": [], "error": "no permission to read this folder",
                "here": looks_like_game(path)}
    entries = []
    for n in names:
        full = os.path.join(path, n)
        if not os.path.isdir(full):
            continue
        if n in (".git", "node_modules", "__pycache__"):
            continue
        try:
            if os.access(full, os.R_OK):
                pass
        except OSError:
            continue
        m = looks_like_game(full)
        entries.append({"name": n, "path": full,
                        "game": bool(m["game_root"] or m["content"]), "exe": m["exe"]})
    parent = os.path.dirname(path.rstrip(os.sep)) or "/"
    return {"path": path, "parent": parent, "entries": entries, "here": looks_like_game(path)}

def write_launcher(root, exe, name, out=None):
    """the same body cmr2lab writes — reusing one definition of 'a launcher'"""
    import textwrap
    name = (name or "").strip() or "Colin McRae Rally 2.0"
    body = textwrap.dedent(f"""\
        [Desktop Entry]
        Type=Application
        Version=1.0
        Name={name}
        Comment=Colin McRae Rally 2.0 — native port / content lab
        Exec={exe}
        Path={root}
        Icon=applications-games
        Categories=Game;
        Terminal=false
        """)
    dest = out or os.path.join(os.path.expanduser("~"),
                               ".local/share/applications/cmr2lab.desktop")
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    with open(dest, "w") as f:
        f.write(body)
    os.chmod(dest, 0o755)
    # read it back — the point is what got WRITTEN, not what we meant to write
    back = open(dest).read()
    exe_line = next((l.split("=", 1)[1] for l in back.splitlines()
                     if l.startswith("Exec=")), "")
    return {"ok": True, "written": dest, "exec": exe_line,
            "exists": os.path.exists(exe_line),
            "runnable": os.access(exe_line, os.X_OK),
            "body": back}

