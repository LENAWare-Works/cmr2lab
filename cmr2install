# --------------------------------------------------------------------- server --
class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass
    def _send(self, code, ctype, body):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)
    def _json(self, obj, code=200):
        self._send(code, "application/json", json.dumps(obj))
    def do_GET(self):
        u = urlparse(self.path)
        if u.path in ("/", "/index.html"):
            home = os.path.expanduser("~")
            page = (PAGE.replace("USERNAME_PLACEHOLDER", json.dumps(os.environ.get("USER", "deck")))
                        .replace("HOME_PLACEHOLDER", json.dumps(home))
                        .replace("LOGO_PLACEHOLDER", LOGO_DATA)
                        .replace("TEX_PLACEHOLDER", TEX_DATA))
            return self._send(200, "text/html; charset=utf-8", page)
        if u.path == "/api/scan":
            return self._json(scan())
        if u.path == "/api/browse":
            q = parse_qs(u.query)
            return self._json(browse((q.get("path") or ["~"])[0]))
        return self._json({"error": "not found"}, 404)
    def do_POST(self):
        u = urlparse(self.path)
        if u.path != "/api/install":
            return self._json({"error": "not found"}, 404)
        try:
            n = int(self.headers.get("Content-Length", 0))
            req = json.loads(self.rfile.read(n) or b"{}")
        except Exception as e:
            return self._json({"ok": False, "why": f"bad request: {e}"})
        root = req.get("root")
        exe = req.get("exe")
        mode = req.get("mode", "auto")
        if not root or not os.path.isdir(root):
            return self._json({"ok": False, "why": f"no such folder: {root}"})
        # mode decides the exe, and a mode that cannot be honoured says so
        nat, ret = lab._exe_in(root)
        if mode == "native":
            if not nat:
                return self._json({"ok": False,
                    "why": "you asked for the native port and there is no cmr2-native "
                           "(or cmr2) in " + root})
            exe = nat
        elif mode == "retail":
            if not ret:
                return self._json({"ok": False,
                    "why": "you asked for the original CMR2.exe and there is none in " + root})
            exe = ret
        else:
            exe = nat or ret or exe
        if not exe:
            return self._json({"ok": False, "why": "no executable to launch in " + root})
        if not os.path.isabs(exe):
            exe = os.path.join(root, exe)
        if not os.path.exists(exe):
            return self._json({"ok": False, "why": f"the executable is not there: {exe}"})
        try:
            out = req.get("out") or None
            return self._json(write_launcher(root, exe, req.get("name"), out))
        except Exception as e:
            return self._json({"ok": False, "why": f"could not write it: {e}"})

# ----------------------------------------------------------------------- main --
def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--port", type=int, default=PORT_DEFAULT)
    ap.add_argument("--no-open", action="store_true")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--scan-json", action="store_true")
    a = ap.parse_args()

    if a.scan_json:
        print(json.dumps(scan(), indent=2)); return 0
    if a.check:
        d = scan()
        print(f"cmr2install {VERSION} — detection only, nothing written")
        if not d["found"]:
            print("\nNOT FOUND. Places checked:")
            for p in d["places"]:
                print(f"  [{p['state']}] {p['label']:<26} {p['path']} {p['note']}")
            print("\n-> point at it yourself in the browser (tier 3), or:")
            print("   cmr2install   then use the folder list.")
            return 1
        for f in d["found"]:
            print(f"\n  root     : {f['root']}")
            print(f"  content  : {f['data']}   ({f['cars']} cars, {f['tracks']} tracks)")
            print(f"  native   : {f['native'] or '- none -'}")
            print(f"  retail   : {f['retail'] or '- none -'}")
            print(f"  found via: {f['how']}")
        return 0

    srv = ThreadingHTTPServer(("127.0.0.1", a.port), H)
    url = f"http://127.0.0.1:{a.port}/"
    print(f"cmr2install {VERSION}")
    print(f"  {url}          (this machine only)")
    print("  Ctrl-C to stop")
    if not a.no_open:
        try: webbrowser.open(url)
        except Exception: pass
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped.")
    return 0

if __name__ == "__main__":
    sys.exit(main())
